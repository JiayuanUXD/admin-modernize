{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "desired-openapi IR",
  "description": "页面和原型真正要调用的操作。从代码抽出的每条都必须带 sources。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "generator", "operations"],
  "properties": {
    "version": { "const": "1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/definitions/operation" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "lineStart"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "summary", "request", "response", "sources", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path": { "type": "string", "pattern": "^/" },
        "summary": { "type": "string" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "body"],
          "properties": {
            "query": { "type": "object" },
            "body": { "type": ["object", "null"] }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
